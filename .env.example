# Required for the preferred Notion content source.
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_WORK_DATABASE_ID=

# Optional Notion-backed sections; the site has local fallbacks.
NOTION_PHOTOS_DATABASE_ID=
NOTION_BELIEFS_DATABASE_ID=
NOTION_SOCIAL_DATABASE_ID=

# Optional build/runtime tuning.
NOTION_TIMEOUT_MS=10000
NOTION_MAX_RETRIES=1
NOTION_MAX_PAGES=100
NOTION_ITEM_CONCURRENCY=4

# Set to 1 in release CI to fail instead of publishing local fallback content.
REQUIRE_NOTION_CONTENT=0
